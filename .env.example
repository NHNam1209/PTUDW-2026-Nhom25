# ==========================================
# Culinary Blog - Environment Configuration
# ==========================================

# Application
ENVIRONMENT=development
PROJECT_NAME="Culinary Blog API"
API_V1_STR=/api/v1
SECRET_KEY=supersecretjwtkeythatmustbeatleast32characterslongforhs256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=culinary_blog
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/culinary_blog
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@postgres:5432/culinary_blog

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO (S3 Compatible Object Storage)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=culinary-blog
MINIO_SECURE=false

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80","http://127.0.0.1:3000"]
